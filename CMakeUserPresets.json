{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-clangcl-release",
      "displayName": "Linux cross build (clang-cl + xwin)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "/mnt/h/dev/modding/toolchain/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "/mnt/h/dev/modding/toolchain/clang-cl-xwin.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-xwin",
        "VCPKG_OVERLAY_TRIPLETS": "/mnt/h/dev/modding/toolchain/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/ports/;/mnt/h/dev/modding/toolchain/ports",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "COMMONLIB_ENABLE_IPO": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "CMAKE_MAKE_PROGRAM": "/usr/bin/ninja",
        "XWIN_EXTRA_CXX_FLAGS": "/permissive- /Zc:preprocessor /EHsc -DWIN32_LEAN_AND_MEAN -DNOMINMAX -DUNICODE -D_UNICODE -D_WIN32_WINNT=0x0A00 /I${sourceDir}/linux-case-alias"
      },
      "environment": {
        "COMMONLIB_SSE_FOLDER": "/mnt/h/dev/modding/toolchain/commonlibsse-ng"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-clangcl-release",
      "configurePreset": "linux-clangcl-release"
    }
  ]
}